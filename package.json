{
  "name": "pluginworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync/run-all.ts",
    "sync:db": "tsx scripts/sync/run-all.ts --db",
